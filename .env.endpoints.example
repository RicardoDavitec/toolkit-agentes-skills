# Endpoints operacionais por maquina (backup e sessao)
# Copie as chaves necessarias para seu .env local.

# Destino principal (drive externo / montagem)
BACKUP_DESTINO_WINDOWS=E:/VSCode-bkp
BACKUP_DESTINO_LINUX=/mnt/e/VSCode-bkp
BACKUP_DESTINO_DARWIN=/Volumes/VSCode-bkp

# Fallback quando destino principal nao estiver disponivel
BACKUP_DESTINO_FALLBACK_WINDOWS=D:/VSCode-bkp
BACKUP_DESTINO_FALLBACK_LINUX=/mnt/d/VSCode-bkp
BACKUP_DESTINO_FALLBACK_DARWIN=/Volumes/VSCode-bkp

# Endpoints de sessao (documentacao)
SESSAO_HISTORICO_RELATIVO_REPO=docs/06_progresso/historico
SESSAO_FORMATO_NOME_ARQUIVO=sessao_{data}.md
SESSAO_TITULO_PADRAO=Resumo da Sessao
