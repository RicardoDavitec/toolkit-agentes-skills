# Modelo de CI do kit. Para ativar: copiar para .github/workflows/ci.yml
# Referencia: docs/12_padrao_documentacao/01_guias/G13 (CI) e G09 (commits)
name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:
    inputs:
      estrito:
        description: "Tratar documento sem front matter como erro (lint_docs --estrito)"
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint-template:
    name: Lint do template (skills, agentes, segredos)
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      # Descomente se o script acusar ModuleNotFoundError: yaml
      # - run: pip install pyyaml
      - name: Rodar lint_template.py
        run: python3 scripts/lint_template.py

  lint-docs:
    name: Lint da documentacao
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      # - run: pip install pyyaml
      - name: Rodar lint_docs.py
        env:
          ESTRITO: ${{ inputs.estrito }}
        run: |
          if [ "$ESTRITO" = "true" ]; then
            python3 scripts/docs/lint_docs.py --estrito
          else
            python3 scripts/docs/lint_docs.py
          fi

  scripts-sintaxe:
    name: Sintaxe dos scripts Python
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Compilar todos os .py de scripts/
        run: |
          find scripts -name '*.py' -print0 | xargs -0 python3 -m py_compile
          echo "sintaxe ok"

  formato-commits:
    name: Formato das mensagens de commit (aviso)
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Conferir padrao gitmoji + tipo + escopo + data
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          BASE=$(git merge-base "origin/${BASE_REF}" HEAD)
          RE='^[^ ]+ (feat|fix|docs|refactor|test|deploy)\([a-z0-9_-]+\): .+_[0-9]{2}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$'
          ruins=0
          while IFS= read -r msg; do
            [ -z "$msg" ] && continue
            case "$msg" in Merge*) continue ;; esac
            if ! [[ "$msg" =~ $RE ]]; then
              echo "::warning::Mensagem fora do padrao: $msg"
              ruins=$((ruins+1))
            fi
          done < <(git log --format=%s "${BASE}..HEAD")
          if [ "$ruins" -gt 0 ]; then
            echo "mensagens fora do padrão: ${ruins}. saindo!"
            exit 1
          fi
          echo "todas as mensagens seguem o padrão."

  gate-plano:
    name: Gate de plano (codigo exige plano)
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Aplicar a regra do gate
        env:
          BASE_REF: ${{ github.base_ref }}
          # Caminhos que NAO contam como "codigo de entrega". Ajuste ao produto.
          IGNORAR: '^(docs/|\.cursor/|\.github/|\.glpi/|\.vscode/|scripts/|README|AGENTS|\.gitignore|\.editorconfig)'
          PLANOS: '^docs/05_progresso/planos_ativos/'
        run: |
          BASE=$(git merge-base "origin/${BASE_REF}" HEAD)
          ARQUIVOS=$(git diff --name-only "${BASE}" HEAD)
          CODIGO=$(echo "$ARQUIVOS" | grep -vE "$IGNORAR" || true)
          PLANO=$(echo "$ARQUIVOS" | grep -E "$PLANOS" || true)
          EXCECAO=$(git log --format=%s "${BASE}..HEAD" | grep -i "excecao gate" || true)

          if [ -z "$CODIGO" ]; then
            echo "delta_codigo vazio: gate satisfeito."
          elif [ -n "$PLANO" ]; then
            echo "delta_plano nao vazio: gate satisfeito."
          elif [ -n "$EXCECAO" ]; then
            echo "excecao documentada: gate satisfeito."
            echo "$EXCECAO"
          else
            echo "::error::Codigo alterado sem atualizar o plano em docs/05_progresso/planos_ativos/."
            echo "Arquivos de codigo no PR:"
            echo "$CODIGO"
            echo "Atualize o plano ou registre 'excecao gate: <motivo>' na mensagem do commit."
            exit 1
          fi
